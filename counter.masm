.prog:
.proc main:
// wires
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:5.5-10.8" ]
	@DEBUGSYMBOL [ symbol = "count" ]
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:3.15-3.20" ]
// \count
	.wire ys_w3 8
// $mux_out$
	.wire ys_w4 8
	.wire  ys_w5 8
// $add$../../examples/practice-counter/counter.sv:9$5_Y
	.wire ys_w6 8
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:6.13-6.24" ]
// $eq$../../examples/practice-counter/counter.sv:6$4_Y
	.wire ys_w7 1
	.wire  ys_w8 8
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:5.5-10.8" ]
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:7.13-7.20" ]
// $manticore_task$../../examples/practice-counter/counter.sv:7$EN$1
	.wire ys_w12 1
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:5.5-10.8" ]
// $0$manticore_task$../../examples/practice-counter/counter.sv:7$EN$1[0:0]$3
	.wire ys_w13 1

// states
	.reg ys_r0 8 .input ys_i1 0b00000000 .output ys_o2
	.reg ys_r9 1 .input ys_i10 0b0 .output ys_o11

// memories
// constants
	.const ys_c0 1 0b1
	.const ys_c1 4 0b1010
	.const ys_c2 1 0b0

// instructions
// $dff_cast$ : $dff
	MOV ys_w3, ys_i1;
	MOV ys_o2, ys_w4;
// $add$../../examples/practice-counter/counter.sv:9$5 : $add
	PADZERO ys_w5, ys_c0, 8;
	ADD ys_w6, ys_w3, ys_w5;
// $dff_mux$ : $mux
	MUX ys_w4, ys_w7, ys_w6, ys_w3;
// $eq$../../examples/practice-counter/counter.sv:6$4 : $eq
	PADZERO ys_w8, ys_c1, 8;
	SEQ ys_w7, ys_w3, ys_w8;
// $manticore$../../examples/practice-counter/counter.sv:7$6 : $manticore
// $procdff$17 : $dff
	MOV ys_w12, ys_i10;
	MOV ys_o11, ys_w13;
// $procmux$11 : $mux
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:6.13-6.24|../../examples/practice-counter/counter.sv:6.9-9.32" ]
	MUX ys_w13, ys_w7, ys_c2, ys_c0;
// $manticore$../../examples/practice-counter/counter.sv:7$6 : $manticore
	@SOURCEINFO [ file = "../../examples/practice-counter/counter.sv:7.13-7.20" ]
	(0) FINISH ys_w12;

