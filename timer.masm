.prog:
.proc main:
// wires
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:7.5-15.8" ]
	@DEBUGSYMBOL [ symbol = "ticks" ]
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:4.15-4.20" ]
// \ticks
	.wire ys_w3 3
// $mux_out$
	.wire ys_w4 3
	.wire  ys_w5 3
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:12.22-12.34" ]
// $add$../../examples/timer/timer.sv:12$5_Y
	.wire ys_w6 3
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:9.13-9.26" ]
// $eq$../../examples/timer/timer.sv:9$4_Y
	.wire ys_w7 1
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:7.5-15.8" ]
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:10.13-10.20" ]
// $manticore_task$../../examples/timer/timer.sv:10$EN$1
	.wire ys_w11 1
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:7.5-15.8" ]
// $0$manticore_task$../../examples/timer/timer.sv:10$EN$1[0:0]$3
	.wire ys_w12 1

// states
	.reg ys_r0 3 .input ys_i1 0b000 .output ys_o2
	.reg ys_r8 1 .input ys_i9 0b0 .output ys_o10

// memories
// constants
	.const ys_c0 1 0b1
	.const ys_c1 3 0b100
	.const ys_c2 1 0b0

// instructions
// $dff_cast$ : $dff
	MOV ys_w3, ys_i1;
	MOV ys_o2, ys_w4;
// $add$../../examples/timer/timer.sv:12$5 : $add
	PADZERO ys_w5, ys_c0, 3;
	ADD ys_w6, ys_w3, ys_w5;
// $dff_mux$ : $mux
	MUX ys_w4, ys_w7, ys_w6, ys_w3;
// $eq$../../examples/timer/timer.sv:9$4 : $eq
	SEQ ys_w7, ys_w3, ys_c1;
// $manticore$../../examples/timer/timer.sv:10$6 : $manticore
// $procdff$17 : $dff
	MOV ys_w11, ys_i9;
	MOV ys_o10, ys_w12;
// $procmux$11 : $mux
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:9.13-9.26|../../examples/timer/timer.sv:9.9-13.12" ]
	MUX ys_w12, ys_w7, ys_c2, ys_c0;
// $manticore$../../examples/timer/timer.sv:10$6 : $manticore
	@SOURCEINFO [ file = "../../examples/timer/timer.sv:10.13-10.20" ]
	(0) FINISH ys_w11;

