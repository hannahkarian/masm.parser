use crate::ast::*; // the module ast.rs and * means import everything
use lalrpop_util::ParseError; // used by the `=>?` actions below to report our own errors

grammar;

// actions written with `=>?` may fail; their error is a String
extern {
    type Error = String;
}

// skip whitespace and // comments
match {
    r"\s*" => { }, // matches whitespace
    r"//[^\n\r]*[\n\r]*" => { }, // [^\n\r]* means any characters except newline
} else {
    _
}

// describes the whole program, which is a sequence of items(processes, annotations, definitions, instructions)
pub Program: Program = {
    ".prog" ":" <items:Item*> =>? build_program(items).map_err(|error| ParseError::User { error }),
    // the * means zero or more items (macro)
    // put them in a Vec<Item> called items
};

Item: Item = {
    ".proc" <name:Ident> ":"  => Item::Proc(name),
    <a:Annotation>            => Item::Annotation(a),
    <d:Def>                   => Item::Def(d),
    <i:Instruction> ";"       => Item::Instruction(i),
};

// @SOURCEINFO [ file = "..." ]
Annotation: Annotation = {
    <name:AnnotName> "[" <key:Ident> "=" <value:Str> "]" => 
        Annotation { name, fields: vec![(key, value)] }, // vec![(key, value)] creates a Vec with one tuple in it
        // full parser in manticore_writer.cc uses the Comma<T> macro for several pairs, but we only need one here
};

Def: Def = {
    ".wire" <name:Ident> <width:Width> =>
        Def::Wire { name, width },
    ".const" <name:Ident> <width:Width> <value:Num> =>
        Def::Const { name, width, value },
    ".reg" <name:Ident> <width:Width> ".input" <current:Ident> <init:Num?> ".output" <next:Ident> => // the ? means optional, so init can be None
        Def::Reg { name, width, current, init, next },
};

Instruction: Instruction = {
    // <rd:Ident> means "parse an Ident here and call it rd"
    // MOV is not mistaken for an Ident because it is a literal string and
    // when a fixed string and a regex match same text, LALRPOP prefers the fixed string. 
    // so literal string win over Ident regex.
    "MOV" <rd:Ident> "," <rs:Ident> =>
        Instruction::Mov { rd, rs },
    "ADD" <rd:Ident> "," <rs1:Ident> "," <rs2:Ident> =>
        Instruction::Add { rd, rs1, rs2 },
    "SEQ" <rd:Ident> "," <rs1:Ident> "," <rs2:Ident> =>
        Instruction::Seq { rd, rs1, rs2 },
    "MUX" <rd:Ident> "," <sel:Ident> "," <rfalse:Ident> "," <rtrue:Ident> =>
        Instruction::Mux { rd, sel, rfalse, rtrue },
    "PADZERO" <rd:Ident> "," <rs:Ident> "," <width:Width> =>
        Instruction::PadZero { rd, rs, width },
    "(" <order:Width> ")" "FINISH" <cond:Ident> =>
        Instruction::Finish { order, cond },
};

// TOKENS
// defined with regular expressions. 
// The syntax is <name>: <type> = <regex> => <action>;

Ident: String = r"[A-Za-z_][A-Za-z0-9_]*" => <>.to_string();
// identifier is a letter or _, followed by letters, digits or _

AnnotName: String = r"@[A-Za-z_]+" => <>[1..].to_string();   
// <>[1..] is a string slice from byte 1 to the end, which drops the '@'

Str: String = <s:r#""[^"]*""#> => s[1..s.len() - 1].to_string(); // drop the quotes
// # is needed because the regex itself contains quotes ""
// "[^"]*" means a quote, followed by zero or more non-quote characters, followed by a quote
// s[1..s.len() - 1] drops the first and the last character

// `=>?` actions return a Result: a number that is too big becomes a parse error
// (with its position) instead of crashing the program with unwrap().
Num: u64 = {
    <s:r"[0-9]+">  =>? s.parse().map_err(|_| ParseError::User { // Decimal number
        error: format!("number `{s}` does not fit in 64 bits"),
    }),
    <s:r"0b[01]+"> =>? u64::from_str_radix(&s[2..], 2).map_err(|_| ParseError::User { // Binary number
        error: format!("number `{s}` does not fit in 64 bits"),
    }),
    // &s[2..] drops the 0b
    // from_str_radix(..., 2) reads the rest as base 2
};

// a width (or FINISH order): a Num that must also fit in a u32
Width: u32 = <n:Num> =>? u32::try_from(n).map_err(|_| ParseError::User {
    error: format!("width `{n}` is too large"),
});
