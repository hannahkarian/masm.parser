use crate::ast::*;
use lalrpop_util::ParseError;

grammar;

// Error type of the fallible `=>?` actions.
extern {
    type Error = String;
}

// Skip whitespace and `//` comments.
match {
    r"\s*" => { },
    r"//[^\n\r]*[\n\r]*" => { },
} else {
    _
}

pub Program: Program = {
    ".prog" ":" <items:Item*> =>? build_program(items).map_err(|error| ParseError::User { error }),
};

Item: Item = {
    ".proc" <name:Ident> ":"  => Item::Proc(name),
    <a:Annotation>            => Item::Annotation(a),
    <d:Def>                   => Item::Def(d),
    <i:Instruction> ";"       => Item::Instruction(i),
};

// @SOURCEINFO [ file = "..." ]
// MASM allows several comma-separated key = value pairs; only one is supported here.
Annotation: Annotation = {
    <name:AnnotName> "[" <key:Ident> "=" <value:Str> "]" =>
        Annotation { name, fields: vec![(key, value)] },
};

Def: Def = {
    ".wire" <name:Ident> <width:Width> =>
        Def::Wire { name, width },
    ".const" <name:Ident> <width:Width> <value:Num> =>
        Def::Const { name, width, value },
    ".reg" <name:Ident> <width:Width> ".input" <current:Ident> <init:Num?> ".output" <next:Ident> =>
        Def::Reg { name, width, current, init, next },
};

Instruction: Instruction = {
    "MOV" <rd:Ident> "," <rs:Ident> =>
        Instruction::Mov { rd, rs },
    "ADD" <rd:Ident> "," <rs1:Ident> "," <rs2:Ident> =>
        Instruction::Add { rd, rs1, rs2 },
    "SEQ" <rd:Ident> "," <rs1:Ident> "," <rs2:Ident> =>
        Instruction::Seq { rd, rs1, rs2 },
    "MUX" <rd:Ident> "," <sel:Ident> "," <rfalse:Ident> "," <rtrue:Ident> =>
        Instruction::Mux { rd, sel, rfalse, rtrue },
    "PADZERO" <rd:Ident> "," <rs:Ident> "," <width:Width> =>
        Instruction::PadZero { rd, rs, width },
    "(" <order:Width> ")" "FINISH" <cond:Ident> =>
        Instruction::Finish { order, cond },
};

Ident: String = r"[A-Za-z_][A-Za-z0-9_]*" => <>.to_string();

// The name without the leading `@`.
AnnotName: String = r"@[A-Za-z_]+" => <>[1..].to_string();

// The contents without the surrounding quotes.
Str: String = <s:r#""[^"]*""#> => s[1..s.len() - 1].to_string();

// A number that is too big becomes a parse error (with its position) instead of a panic.
Num: u64 = {
    <s:r"[0-9]+">  =>? s.parse().map_err(|_| ParseError::User {
        error: format!("number `{s}` does not fit in 64 bits"),
    }),
    <s:r"0b[01]+"> =>? u64::from_str_radix(&s[2..], 2).map_err(|_| ParseError::User {
        error: format!("number `{s}` does not fit in 64 bits"),
    }),
};

// A width (or FINISH order).
Width: u32 = <n:Num> =>? u32::try_from(n).map_err(|_| ParseError::User {
    error: format!("width `{n}` is too large"),
});
