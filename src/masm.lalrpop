use crate::ast::*;
use lalrpop_util::ParseError;
use num_bigint::BigUint;

grammar;

// Error type of the fallible `=>?` actions.
extern {
    type Error = String;
}

// Skip whitespace and `//` comments.
match {
    r"\s*" => { },
    r"//[^\n\r]*[\n\r]*" => { },
} else {
    _
}

pub Program: Program = {
    ".prog" ":" <items:Items> =>? build_program(items).map_err(|error| ParseError::User { error }),
};

// Public so the tests can look at annotations before build_program drops them.
pub Items: Vec<Item> = Item*;

Item: Item = {
    ".proc" <name:Ident> ":"  => Item::Proc(name),
    <a:Annotation>            => Item::Annotation(a),
    <d:Def>                   => Item::Def(d),
    <i:Instruction> ";"       => Item::Instruction(i),
};

// @MEMBLOCK [ block = "mem", width = 8, capacity = 16 ]
// The bracketed list is optional, as in the Scala parser.
Annotation: Annotation = {
    <name:AnnotName> <fields:("[" <Comma<KeyValue>> "]")?> =>
        Annotation { name, fields: fields.unwrap_or_default() },
};

KeyValue: (String, AnnotationValue) = <Ident> "=" <AnnotationValue>;

AnnotationValue: AnnotationValue = {
    <Str> => AnnotationValue::Str(<>),
    <n:Num> =>? u64::try_from(&n).map(AnnotationValue::Int).map_err(|_| ParseError::User {
        error: format!("annotation value `{n}` does not fit in 64 bits"),
    }),
};

// Zero or more T separated by commas, without a trailing comma.
Comma<T>: Vec<T> = {
    => Vec::new(),
    <mut v:(<T> ",")*> <last:T> => {
        v.push(last);
        v
    },
};

Def: Def = {
    ".wire" <name:Ident> <width:Width> =>
        Def::Wire { name, width },
    ".const" <name:Ident> <width:Width> <value:Num> =>
        Def::Const { name, width, value },
    ".reg" <name:Ident> <width:Width> ".input" <current:Ident> <init:Num?> ".output" <next:Ident> =>
        Def::Reg { name, width, current, init, next },
};

Instruction: Instruction = {
    "MOV" <rd:Ident> "," <rs:Ident> =>
        Instruction::Mov { rd, rs },
    <op:BinaryOp> <rd:Ident> "," <rs1:Ident> "," <rs2:Ident> =>
        Instruction::Binary { op, rd, rs1, rs2 },
    "MUX" <rd:Ident> "," <sel:Ident> "," <rfalse:Ident> "," <rtrue:Ident> =>
        Instruction::Mux { rd, sel, rfalse, rtrue },
    "PADZERO" <rd:Ident> "," <rs:Ident> "," <width:Width> =>
        Instruction::PadZero { rd, rs, width },
    "(" <order:Width> ")" "FINISH" <cond:Ident> =>
        Instruction::Finish { order, cond },
};

// The ALU operations, which all look like `OP rd, rs1, rs2`.
BinaryOp: BinaryOp = {
    "ADD"  => BinaryOp::Add,
    "SUB"  => BinaryOp::Sub,
    "MUL"  => BinaryOp::Mul,
    "AND"  => BinaryOp::And,
    "OR"   => BinaryOp::Or,
    "XOR"  => BinaryOp::Xor,
    "SLL"  => BinaryOp::Sll,
    "SRL"  => BinaryOp::Srl,
    "SRA"  => BinaryOp::Sra,
    "SEQ"  => BinaryOp::Seq,
    "SLT"  => BinaryOp::Slt,
    "SLTS" => BinaryOp::Slts,
};

Ident: String = r"[A-Za-z_][A-Za-z0-9_]*" => <>.to_string();

// The name without the leading `@`.
AnnotName: String = r"@[A-Za-z_][A-Za-z0-9_]*" => <>[1..].to_string();

// The contents without the surrounding quotes.
Str: String = <s:r#""[^"]*""#> => s[1..s.len() - 1].to_string();

// Arbitrarily large: constants and register init values can be wider than 64 bits.
// The unwraps cannot fail, the regexes only let valid digits through.
Num: BigUint = {
    <s:r"[0-9]+">         => BigUint::parse_bytes(s.as_bytes(), 10).unwrap(),
    <s:r"0b[01]+">        => BigUint::parse_bytes(s[2..].as_bytes(), 2).unwrap(),
    <s:r"0x[0-9a-fA-F]+"> => BigUint::parse_bytes(s[2..].as_bytes(), 16).unwrap(),
};

// A width (or FINISH order).
Width: u32 = <n:Num> =>? u32::try_from(&n).map_err(|_| ParseError::User {
    error: format!("width `{n}` is too large"),
});
