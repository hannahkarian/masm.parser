# Equivalence check: shift.sv (gold) vs shift_generated.sv (gate, made by masm_parser).
# Same setup as alu.eqy (see the comments there and in stepper.eqy).

[gold]
read_verilog -sv -DEQY shift.sv
setattr -set keep 1 w:* w:$* %d
prep -top Main

[gate]
read_verilog -sv shift_generated.sv
prep -top Main

[strategy sat]
use sat
depth 10
